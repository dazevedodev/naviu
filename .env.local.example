# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify (webhook de assinatura)
KIWIFY_WEBHOOK_TOKEN=

# Kiwify — Solo e Barbearia são dois produtos separados
KIWIFY_PRODUTO_ID_PLANO_SOLO=
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL_SOLO=
KIWIFY_PRODUTO_ID_PLANO_BARBEARIA=
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL_BARBEARIA=

# Kiwify — complemento pago do sinal via PIX (R$15/mês)
KIWIFY_PRODUTO_ID_ADDON_SINAL=
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL_ADDON_SINAL=

# Resend (confirmação/lembrete pro cliente, notificação de novo agendamento pro admin)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Naviu <agendamentos@naviu.app.br>"

# Endpoint /api/cron/lembretes — chamado por um agendador externo (cron-job.org)
# a cada poucos minutos, já que o plano Hobby da Vercel só permite cron 1x/dia.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
