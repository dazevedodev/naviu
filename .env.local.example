# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (assinatura do Naviu) — mesma conta dos outros produtos da Zantte.
# ASAAS_AMBIENTE=sandbox usa o ambiente de testes; vazio usa a conta real.
ASAAS_API_KEY=
ASAAS_AMBIENTE=
# Token que o Asaas manda no cabeçalho asaas-access-token do webhook
# (configurado em Integrações > Webhooks, apontando pra /api/webhooks/asaas).
ASAAS_WEBHOOK_TOKEN=

# Kiwify (legado) — só pra continuar renovando quem já assinava por lá.
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_PRODUTO_ID_PLANO_SOLO=
KIWIFY_PRODUTO_ID_PLANO_BARBEARIA=

# Resend (confirmação/lembrete pro cliente, notificação de novo agendamento pro admin)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Naviu <agendamentos@naviu.app.br>"

# E-mail do dono do Naviu — recebe leads de interesse em site personalizado
NAVIU_OWNER_EMAIL=

# Endpoint /api/cron/lembretes — chamado por um agendador externo (cron-job.org)
# a cada poucos minutos, já que o plano Hobby da Vercel só permite cron 1x/dia.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Agente de IA (chat "Agendar conversando" na página da barbearia).
# Chave criada em console.anthropic.com. Sem ela, o chat simplesmente não aparece.
ANTHROPIC_API_KEY=
# Opcional: outro modelo Claude (padrão claude-haiku-5-5).
NAVIU_MODELO_IA=
